# Copy to .env and fill in values.
SITE_URL=http://127.0.0.1:8000

# Brevo SMTP — app.brevo.com → SMTP & API → SMTP keys
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your-id@smtp-brevo.com
EMAIL_HOST_PASSWORD=your-brevo-smtp-key
BREVO_SMTP_KEY=your-brevo-smtp-key
# Or use Brevo REST API key (xkeysib-…) — preferred on Render; do not use API key as SMTP password:
BREVO_API_KEY=
# Verified sender in Brevo (not the @smtp-brevo.com login):
DEFAULT_FROM_EMAIL=your-verified-sender@gmail.com

# Where public contact form notifications are sent (overridden by Site settings → Enquiry inbox in Admin)
CONTACT_ENQUIRY_EMAIL=poonghuzhali1990@gmail.com
