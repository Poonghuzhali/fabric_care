# Copy to .env and fill in your Gmail (same account that created the app password).
SITE_URL=http://127.0.0.1:8000

# Optional: Google Maps (Places + map pin on Book form). Enable Maps JavaScript API + Places API.
GOOGLE_MAPS_API_KEY=

# Razorpay test mode: dashboard.razorpay.com → Settings → API Keys → Test mode
# Key ID looks like rzp_test_xxxx — Key secret is shown once when you generate/regenerate keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=your.name@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=your.name@gmail.com
